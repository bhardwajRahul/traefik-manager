# Traefik Manager Agent (TMA) - environment variables
#
# The agent runs next to Traefik on a remote server and is driven entirely by
# environment variables; it has no settings file of its own. Only TMA_API_KEY is
# required. Copy to .env and uncomment what you need.
#
# Anything the agent is not configured for simply does not appear in the UI for
# that server: no ACME_JSON_PATH means no Certificates tab, and so on.
#
# Full reference: https://traefik-manager.xyzlab.dev/agent.html

# ─── Required ─────────────────────────────────────────────────────────────────

# Generated in Traefik Manager under Settings - Agents when you add this server.
# Shown once, so copy it then. Rotating it in the UI invalidates this value.
TMA_API_KEY=

# ─── Agent server ─────────────────────────────────────────────────────────────

# Port the agent listens on. Must match the port in the agent's URL in the UI.
#TMA_PORT=8090

# Requests per minute per client IP. 0 disables the limit. The default is
# deliberately generous: a single tab switch makes many API calls.
#TMA_RATE_LIMIT=300

# Log every failed Traefik API call (URL and status) to the journal. The agent
# is otherwise near-silent, so turn this on when a tab shows an error in the UI
# but journalctl shows nothing.
#TMA_DEBUG=false

# ─── Traefik connection ───────────────────────────────────────────────────────

# Traefik's API on this server. Use the internal address; a public dashboard URL
# behind auth returns 401 for every call.
#TRAEFIK_API_URL=http://traefik:8080

# Credentials, if that API is behind basic auth. Both are required together.
#TRAEFIK_API_USER=
#TRAEFIK_API_PASSWORD=

# Skip TLS verification for an https API with a self-signed or Origin cert.
#TRAEFIK_INSECURE_SKIP_VERIFY=false

# ─── Config files ─────────────────────────────────────────────────────────────

# Dynamic config. A directory means every .yml/.yaml in it is managed; a single
# file means just that file. This is what the Routes and Middlewares tabs read,
# so it must point at the files Traefik's file provider actually watches.
#CONFIG_PATH=/app/config

# Traefik's static config - enables the Static Config editor for this server.
#STATIC_CONFIG_PATH=/etc/traefik/traefik.yml

# ─── Optional paths ───────────────────────────────────────────────────────────

# acme.json - enables the Certificates tab. Accepts several files
# comma-separated, or a directory whose .json files are all read, since Traefik
# writes one storage file per cert resolver.
#
# Read-only shows your certificates and which of them nothing uses. Make it
# writable and set RESTART_METHOD below to also remove them from the tab.
#ACME_JSON_PATH=/etc/traefik/acme.json
#ACME_JSON_PATH=/letsencrypt/ovh.json,/letsencrypt/lan.json
#ACME_JSON_PATH=/letsencrypt

# Traefik access log - enables the Logs tab for this server.
#ACCESS_LOG_PATH=/var/log/traefik/access.log

# Traefik plugins directory.
#PLUGINS_DIR=/plugins-local

# ─── Backups ──────────────────────────────────────────────────────────────────

# Where the agent writes .bak files before each change. On a binary install
# make sure this directory is writable and persists across upgrades.
#BACKUP_DIR=/app/backups

# Keep only the last N backups per file. 0 keeps everything.
#BACKUP_KEEP_COUNT=0

# ─── Traefik restart ──────────────────────────────────────────────────────────

# proxy, poison-pill or socket. Without this, static config changes are saved
# but Traefik is not restarted.
#RESTART_METHOD=proxy

#TRAEFIK_CONTAINER=traefik

# Docker socket-proxy endpoint, used by the proxy method.
#DOCKER_HOST=tcp://socket-proxy:2375

# Signal file the poison-pill method writes, when no socket is available.
#SIGNAL_FILE_PATH=/signals/restart.sig

# ─── CrowdSec ─────────────────────────────────────────────────────────────────

#CROWDSEC_LAPI_URL=http://crowdsec:8080

# Bouncer key - reads decisions.
#CROWDSEC_API_KEY=

# Machine login - required to read alerts and to unban.
#CROWDSEC_MACHINE_ID=
#CROWDSEC_MACHINE_PASSWORD=

# Client certificate, if this LAPI is behind mutual TLS. Paths on this server.
# Authenticates decisions instead of the bouncer key, and alerts instead of the
# machine login, or alongside them.
#CROWDSEC_CLIENT_CERT=
#CROWDSEC_CLIENT_KEY=

# Verifies the LAPI's own certificate when it comes from a private CA.
#CROWDSEC_CA_CERT=

# Seconds to wait for a LAPI read, between 1 and 120.
#CROWDSEC_READ_TIMEOUT=20

# Most recent alerts to fetch. 0 disables alert reading entirely.
#CROWDSEC_ALERT_LIMIT=500

# ─── Git backup (agent-managed) ───────────────────────────────────────────────
#
# Only needed if this agent pushes to its own repository. If you instead enable
# "Use Host Repository" in the UI, the Host pushes this agent's config to its
# own repo on a dedicated branch and none of these are used.

#GIT_BACKUP_ENABLED=false

# https:// or ssh://. file:// and ext:: are rejected.
#GIT_BACKUP_REPO=https://github.com/you/traefik-config.git
#GIT_BACKUP_BRANCH=main

# For https remotes. The token is passed through an askpass helper, never
# embedded in the remote URL.
#GIT_BACKUP_USERNAME=
#GIT_BACKUP_TOKEN=

# Push automatically after every config change.
#GIT_BACKUP_AUTO_PUSH=true

# {action} and {timestamp} are substituted.
#GIT_BACKUP_COMMIT_MESSAGE=traefik-manager: {action} at {timestamp}
